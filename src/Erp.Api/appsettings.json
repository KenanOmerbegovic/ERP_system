{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Identity": {
    "Jwt": {
      "Issuer": "erp-api",
      "Audience": "erp-client"
    },
    "Sessions": {
      "AccessTokenLifetime": "00:15:00",
      "RefreshTokenLifetime": "14.00:00:00"
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "Duration": "00:15:00"
    },
    "RateLimiting": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    },
    "Registration": {
      "KeyLifetime": "7.00:00:00"
    }
  },
  "Messaging": {
    "Outbox": {
      "PollInterval": "00:00:01",
      "BatchSize": 50,
      "MaxAttempts": 10
    }
  }
}
