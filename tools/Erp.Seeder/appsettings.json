{
  "ConnectionStrings": {
    "Erp": "Host=localhost;Port=5433;Database=erp_dev;Username=erp;Password=erp_dev_password"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.EntityFrameworkCore.Database": "None"
    }
  },
  "Identity": {
    "Jwt": {
      "Issuer": "erp-api",
      "Audience": "erp-client"
    },
    "Sessions": {
      "AccessTokenLifetime": "00:15:00",
      "RefreshTokenLifetime": "14.00:00:00"
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "Duration": "00:15:00"
    },
    "RateLimiting": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    },
    "Registration": {
      "KeyLifetime": "01:00:00"
    }
  },
  "Messaging": {
    "Outbox": {
      "PollInterval": "00:00:00.100",
      "BatchSize": 50,
      "MaxAttempts": 10
    }
  }
}
